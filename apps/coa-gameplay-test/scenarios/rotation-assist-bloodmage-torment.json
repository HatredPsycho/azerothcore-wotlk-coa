      "label": "Shoot is never cast in its place",
      "actor": "bloodmage",
      "metric": "spell_go_count",
      "spell": 3018,
      "equals": 0
    },
    {
      "action": "assert",
      "label": "The bleed on the second enemy expires",
      "actor": "second",
      "metric": "aura",
      "spell": 802568,
      "caster": "bloodmage",
      "equals": 0,
