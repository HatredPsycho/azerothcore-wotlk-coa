[worldserver]

#
#    CoACompanions.Enable
#        Description: Load the CoACompanions frame into the client at login and after every /reload,
#                     and send it the health of the player's summoned companions to draw. With this
#                     off neither the frame nor the health feed is sent.
#        Default:     1 - enabled
#                     0 - disabled
#

CoACompanions.Enable = 1

#
#    CoACompanions.Interval
#        Description: Milliseconds between two updates for one player. One message is sent per
#                     interval only when the values changed, plus a keep alive every 3 seconds so
#                     the addon can tell a live reading from a stale one.
#        Default:     1000
#        Minimum:     250
#

CoACompanions.Interval = 1000
